{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joshua-wopr",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  }
}
